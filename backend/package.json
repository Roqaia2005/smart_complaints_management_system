{
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
   "scripts": {
  "start": "node src/index.js",
  "dev": "nodemon src/index.js",

  "db:migrate": "npx sequelize-cli db:migrate",
  "db:undo": "npx sequelize-cli db:migrate:undo",

  "db:seed": "npx sequelize-cli db:seed:all",

  "setup": "npm install && npx sequelize-cli db:migrate && npx sequelize-cli db:seed:all"
},
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mysql2": "^3.22.0",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5"
  }
}
